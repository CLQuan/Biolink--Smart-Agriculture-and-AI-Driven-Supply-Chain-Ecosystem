# Root environment template for Bio-Link. Copy to .env and adjust.
# Each service also has its own .env.example.

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=biolink
POSTGRES_PASSWORD=biolink
POSTGRES_DB=biolink

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API Gateway ---
API_PORT=4000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
ACCOUNT_LOCKOUT_THRESHOLD=5

# --- ML inference server ---
ML_INFERENCE_URL=http://localhost:8000
AI_CONFIDENCE_THRESHOLD=0.75
